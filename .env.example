# Porta su cui ascolta il server (Railway la imposta da sola in produzione)
PORT=3000

# Supabase — Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# GitHub App di JoJoX — Settings → Developer settings → GitHub Apps → (la tua app)
GITHUB_APP_ID=
# Il file .pem scaricato da GitHub, codificato in base64 su una sola riga:
#   base64 -i jojox-app-private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY_BASE64=
# Impostato tu stesso in fase di creazione della App, sotto "Webhook secret"
GITHUB_WEBHOOK_SECRET=
