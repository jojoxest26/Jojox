# Porta su cui ascolta il server (Railway la imposta da sola in produzione)
PORT=3000

# Supabase — Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# GitHub App di JoJoX — Settings → Developer settings → GitHub Apps → (la tua app)
GITHUB_APP_ID=
# Il file .pem scaricato da GitHub, codificato in base64 su una sola riga:
#   base64 -i jojox-app-private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY_BASE64=
# Impostato tu stesso in fase di creazione della App, sotto "Webhook secret"
GITHUB_WEBHOOK_SECRET=

# URL pubblico del sito (usato nei redirect di Stripe dopo il pagamento)
APP_URL=http://localhost:5173

# Stripe — Developers → API keys (usa quelle di test finché non sei pronto
# per i pagamenti veri). Opzionali: finché mancano, il resto del sito
# funziona comunque, solo l'abbonamento self-service resta disattivato.
STRIPE_SECRET_KEY=
# Developers → Webhooks → (il tuo endpoint) → Signing secret
STRIPE_WEBHOOK_SECRET=
# Product catalog → crea un prodotto "Pro" e uno "Team", ognuno con un
# prezzo ricorrente mensile → copia l'ID del prezzo (inizia con "price_")
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TEAM=