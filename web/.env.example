# URL del backend (Railway) — vedi SETUP.md
VITE_API_URL=http://localhost:3000

# Supabase — Project Settings → API. Qui va la chiave "anon public",
# MAI la service_role: questa finisce nel bundle del browser, dev'essere
# per forza quella pensata per il client (protetta dalla RLS).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Lo "slug" della GitHub App di JoJoX (l'ultima parte dell'URL della sua
# pagina pubblica, es. github.com/apps/<questo>), usato per il bottone
# "Collega GitHub".
VITE_GITHUB_APP_SLUG=jojox
